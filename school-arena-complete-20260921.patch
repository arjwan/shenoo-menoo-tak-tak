+        $('selectedTeacherUserId').value = '';
+        $('selectedTeacherUserPreview').hidden = true;
+        slots.length = 0;
+        renderSlots();
+        $('standaloneAddTeacherForm').hidden = false;
+        $('teacherSuccessCard').hidden = true;
+      });
+    })();
+  </script>
+</body>
+</html>
