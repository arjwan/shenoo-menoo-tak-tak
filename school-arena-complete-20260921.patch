+
+  <script>
+    (function () {
+      const token = localStorage.getItem('token') || sessionStorage.getItem('token') || '';
+      const $ = (id) => document.getElementById(id);
+      const escapeHtml = (s) => String(s || '').replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
+
+      function alertMsg(txt, isErr = false) {
+        const box = $('teacherAlert');
+        $('teacherAlertText').textContent = txt;
+        box.className = 'admin-alert ' + (isErr ? 'alert-danger' : 'alert-success');
+        box.hidden = false;
+        window.scrollTo({ top: 0, behavior: 'smooth' });
+      }
+
+      async function api(path, opts = {}) {
+        const res = await fetch('/api/school/management' + path, {
+          ...opts,
+          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token, ...(opts.headers || {}) }
+        });
+        const d = await res.json().catch(() => ({}));
+        if (!res.ok) throw new Error(d.message || 'خطأ في الخادم (' + res.status + ')');
+        return d;
+      }
+
+      // Live Search for Real User
+      let searchTimer = null;
+      $('teacherUserSearch').addEventListener('input', function () {
+        clearTimeout(searchTimer);
+        const q = this.value.trim();
+        const drop = $('teacherUserSearchDropdown');
+        if (q.length < 2) { drop.hidden = true; return; }
+        searchTimer = setTimeout(async () => {
+          try {
+            const res = await api('/users/search?q=' + encodeURIComponent(q));
+            if (!res.users || !res.users.length) {
+              drop.innerHTML = '<div style="padding:10px;text-align:center;color:#64748b;">لا يوجد حساب مطابق. يمكنك دعوة المعلم لإنشاء حساب عبر الرابط أدناه.</div>';
+              drop.hidden = false;
+              return;
+            }
+            drop.innerHTML = res.users.map((u) => `
+              <div class="search-item" data-id="${u._id}" data-name="${escapeHtml(u.fullName || u.username)}" data-phone="${escapeHtml(u.phone || '')}" data-meta="${escapeHtml(u.email || u.phone || '')}">
+                <div><b>${escapeHtml(u.fullName || u.username)}</b> <small>@${escapeHtml(u.username)}</small></div>
+                <span class="role-pill role-${u.role}">${u.role}</span>
+              </div>
+            `).join('');
+            drop.hidden = false;
+            drop.querySelectorAll('.search-item').forEach((item) => {
+              item.addEventListener('click', () => {
+                $('selectedTeacherUserId').value = item.dataset.id;
+                $('previewTeacherUserName').textContent = item.dataset.name;
+                $('previewTeacherUserMeta').textContent = item.dataset.meta;
+                $('selectedTeacherUserPreview').hidden = false;
+                $('teacherName').value = item.dataset.name;
+                $('teacherPhone').value = item.dataset.phone;
+                $('teacherUserSearch').value = '';
+                drop.hidden = true;
+              });
+            });
+          } catch { drop.hidden = true; }
+        }, 300);
+      });
+
+      $('clearTeacherUserBtn').addEventListener('click', () => {
+        $('selectedTeacherUserId').value = '';
+        $('selectedTeacherUserPreview').hidden = true;
+      });
+
+      $('copyInviteLinkBtn').addEventListener('click', () => {
+        navigator.clipboard.writeText($('teacherInviteLinkInput').value);
+        alertMsg('تم نسخ رابط دعوة المعلم إلى الحافظة.');
+      });
+
+      // Schedule Slots
+      const slots = [];
+      $('addScheduleSlotBtn').addEventListener('click', () => {
+        const day = $('slotDay').value;
+        const startTime = $('slotStart').value;
+        const endTime = $('slotEnd').value;
+        const subject = $('slotSubject').value;
+        const grade = $('slotGrade').value;
+        if (!subject || !grade) { alertMsg('المادة والصف مطلوبان للحصة', true); return; }
+        slots.push({ day, startTime, endTime, subject, grade, stage: 'ابتدائي', section: 'أ' });
+        renderSlots();
+      });
+
+      function renderSlots() {
+        const tbody = $('scheduleSlotsTbody');
+        if (!slots.length) {
+          tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--admin-text-muted);">لم يتم إضافة حصص في الجدول بعد.</td></tr>';
+          return;
+        }
+        tbody.innerHTML = slots.map((s, idx) => `
+          <tr>
+            <td><b>${escapeHtml(s.day)}</b></td>
+            <td>${escapeHtml(s.startTime)} - ${escapeHtml(s.endTime)}</td>
+            <td>${escapeHtml(s.subject)}</td>
+            <td>${escapeHtml(s.grade)}</td>
+            <td><button type="button" class="btn btn-sm btn-danger remove-slot-btn" data-idx="${idx}">حذف</button></td>
+          </tr>
+        `).join('');
+
+        tbody.querySelectorAll('.remove-slot-btn').forEach((b) => {
+          b.addEventListener('click', () => {
+            slots.splice(Number(b.dataset.idx), 1);
+            renderSlots();
+          });
+        });
+      }
+
+      // Submit Form
+      $('standaloneAddTeacherForm').addEventListener('submit', async function (e) {
+        e.preventDefault();
+        const userId = $('selectedTeacherUserId').value;
+        if (!userId) {
+          alertMsg('يجب اختيار حساب مستخدم حقيقي مسجل في شنو منو أولاً.', true);
+          return;
+        }
+        try {
+          const res = await api('/teachers', {
+            method: 'POST',
+            body: JSON.stringify({
+              userId,
+              name: $('teacherName').value,
+              gender: $('teacherGender').value,
+              phone: $('teacherPhone').value,
+              stages: $('teacherStages').value.split('،').map((s) => s.trim()).filter(Boolean),
+              grades: $('teacherGrades').value.split('،').map((g) => g.trim()).filter(Boolean),
+              sections: $('teacherSections').value.split('،').map((sec) => sec.trim()).filter(Boolean),
+              subjects: $('teacherSubjects').value.split('،').map((sub) => sub.trim()).filter(Boolean),
+              scheduleSlots: slots
+            })
+          });
+
+          $('standaloneAddTeacherForm').hidden = true;
+          const t = res.teacher;
+          $('teacherSuccessSummaryText').textContent = `تم تعيين ${t.name} كمعلم معتمد لمواد (${(t.subjects || []).join('، ')}) للمراحل (${(t.stages || []).join('، ')}).`;
+          $('teacherSuccessCard').hidden = false;
+        } catch (err) {
+          alertMsg(err.message, true);
+        }
+      });
+
+      $('registerAnotherTeacherBtn').addEventListener('click', () => {
