PORT=3000
# Application runtime still uses MongoDB until the MySQL service port is complete.
DB_CLIENT=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/shno_mano_tak_tak
# MySQL destination settings are used only by mysql:schema tooling at this stage.
# Use the exact database/user names issued by IQ Hosting, including their prefix.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL_MODE=required
# Optional private CA certificate path. For a local Unix host without TLS, set
# MYSQL_SSL_MODE=disabled only when that matches the hosting connection setup.
MYSQL_SSL_CA_FILE=
JWT_SECRET=change-this-to-a-long-random-secret

DEVELOPER_NAME=Platform Developer
DEVELOPER_USERNAME=developer
DEVELOPER_CONTACT=developer@example.com
DEVELOPER_PASSWORD=CHANGE_ME_NOW

# Registration OTP uses email only. SMS is intentionally disabled. Never commit real values.
# Keep false during early testing; switch to true before public release.
REGISTRATION_OTP_REQUIRED=false
OTP_DELIVERY_MODE=email
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace-with-a-separate-long-random-secret
# Brevo free tier is preferred; Resend remains an optional fallback.
BREVO_API_KEY=replace-with-brevo-api-key
RESEND_API_KEY=replace-with-resend-api-key
OTP_FROM_EMAIL=verify@example.com
OTP_FROM_NAME=شنو منو اتصال
# Comma-separated production web origins when cross-origin access is needed.
CORS_ORIGINS=https://shino-mino-tak-tak.duckdns.org

# School Canva virtual classroom (adapter for original-assets/school-canva).
# No secrets live in the frontend; TURN (optional) is configured here only
# and delivered to the authenticated classroom config endpoint.
SCHOOL_CLASSROOM_ENV=production
SCHOOL_CANVA_SCHEMA_VERSION=1.0
SCHOOL_CANVA_REQUEST_TIMEOUT_MS=8000
SCHOOL_STUN_URL=stun:stun.l.google.com:19302
# Optional TURN (Coturn or similar). Leave empty to use STUN only.
SCHOOL_TURN_URIS=
SCHOOL_TURN_USERNAME=
SCHOOL_TURN_CREDENTIAL=
