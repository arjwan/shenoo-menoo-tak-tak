PORT=3000
NODE_ENV=production
# Existing MongoDB Atlas/cluster URI. Keep the secret in hosting environment variables only.
MONGODB_URI=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
JWT_SECRET=change-this-to-a-long-random-secret

# Preserve the existing developer account. Do not run bootstrap/recovery automatically.
# Configure only when explicitly provisioning a fresh environment after verifying identity.
DEVELOPER_NAME=Platform Developer
DEVELOPER_USERNAME=developer
DEVELOPER_CONTACT=developer@example.com
DEVELOPER_PASSWORD=CHANGE_ME_NOW
DEVELOPER_BOOTSTRAP=
DEVELOPER_RECOVERY_USER_ID=
TRUST_PROXY=

REGISTRATION_OTP_REQUIRED=false
OTP_DELIVERY_MODE=email
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace-with-a-separate-long-random-secret
BREVO_API_KEY=replace-with-brevo-api-key
RESEND_API_KEY=replace-with-resend-api-key
OTP_FROM_EMAIL=verify@example.com
OTP_FROM_NAME=شنو منو اتصال
CORS_ORIGINS=

SCHOOL_CLASSROOM_ENV=production
SCHOOL_CANVA_SCHEMA_VERSION=1.0
SCHOOL_CANVA_REQUEST_TIMEOUT_MS=8000
SCHOOL_STUN_URL=stun:stun.l.google.com:19302
SCHOOL_TURN_URIS=
SCHOOL_TURN_USERNAME=
SCHOOL_TURN_CREDENTIAL=

# Optional auxiliary Cloudflare D1 integration; MongoDB remains the primary database.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# Optional Cloudflare R2 object storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shno-mano-media
R2_ENDPOINT=
