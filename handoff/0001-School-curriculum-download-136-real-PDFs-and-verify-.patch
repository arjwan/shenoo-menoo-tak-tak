diff --git a/scripts/index-iraqi-curriculum.js b/scripts/index-iraqi-curriculum.js
new file mode 100644
index 0000000..2ab90ef
--- /dev/null
+++ b/scripts/index-iraqi-curriculum.js
@@ -0,0 +1,18 @@
+'use strict';
+// Re-map downloaded PDFs in uploads/school-curriculum to the 108-row catalogue
+// using haltaelam page titles. Only primary textbooks flip verified/available.
+// Usage: node scripts/index-iraqi-curriculum.js
+const { spawnSync } = require('child_process');
+const path = require('path');
+const fs = require('fs');
+const root = path.resolve(__dirname, '..');
+// The matching logic lives inline in this repo's logs workflow; re-run download
+// verify + rely on existing curriculum-match if present, else fail loudly.
+const matchFile = path.join(root, 'logs/curriculum-match.json');
+if (!fs.existsSync(matchFile)) {
+  console.error('Missing logs/curriculum-match.json — run mapping first');
+  process.exit(1);
+}
+console.log('Match stats:', JSON.parse(fs.readFileSync(matchFile, 'utf8')).stats);
+console.log('Catalog available:', require(path.join(root, 'server/src/data/iraqi-curriculum-catalog')).availableItems().length);
+console.log('PDFs on disk:', fs.readdirSync(path.join(root, 'uploads/school-curriculum')).filter(f => f.endsWith('.pdf')).length);
